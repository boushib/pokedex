{
  "name": "pokedex",
  "version": "2.0.0",
  "private": true,
  "description": "A fast, offline-friendly Pokédex: all 1,025 Pokémon with stats, evolutions, matchups, a team builder and a compare view",
  "scripts": {
    "dev": "next dev",
    "dev:agent": "PORT=3500 NEXT_DIST_DIR=.next-agent next dev -p 3500",
    "build": "next build",
    "build:agent": "NEXT_DIST_DIR=.next-build next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "data": "tsx scripts/fetch-data.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
